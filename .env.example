# --- Database (docker compose: postgres on localhost:5432) ---
DATABASE_URL=postgresql://champ:champ@localhost:5432/champ
# Optional: database used by `pnpm test` (default: DATABASE_URL with db name champ_test)
# TEST_DATABASE_URL=postgresql://champ:champ@localhost:5432/champ_test

# --- API ---
JWT_ACCESS_SECRET=change-me
API_PORT=4000
WEB_URL=http://localhost:5173

# --- Google sign-in (leave GOOGLE_CLIENT_ID empty to hide the button) ---
GOOGLE_CLIENT_ID=
GOOGLE_ALLOWED_DOMAIN=intellicar.in

# --- Seeded Super Admin (pnpm db:seed) ---
SEED_SUPERADMIN_EMAIL=admin@intellicar.in
SEED_SUPERADMIN_PASSWORD=Admin@1234

# --- Object storage for photos (F06, MinIO via docker compose; the bucket is created at API start and kept private) ---
# STORAGE_DRIVER=s3          # s3 (default) or memory (tests)
S3_ENDPOINT=http://localhost:9000
# Endpoint used to sign photo URLs; must be reachable from the browser
S3_PUBLIC_URL=http://localhost:9000
S3_ACCESS_KEY=champ
S3_SECRET_KEY=champchamp
S3_BUCKET=champ

# --- Geocoding (F03): address search and reverse lookup, proxied by the API ---
# Nominatim base URL (public OSM instance by default; max 1 request/second is enforced by the API)
NOMINATIM_URL=https://nominatim.openstreetmap.org
# Contact sent in the User-Agent header, as the OSM usage policy asks
GEOCODER_CONTACT_EMAIL=admin@intellicar.in

# --- Dev technician simulator (F05): acts as the assigned technician until the mobile app exists ---
# Never mounted when NODE_ENV=production. Unset: on in development, off otherwise.
ENABLE_DEV_SIMULATOR=true
