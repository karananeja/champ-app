generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  OM
  OE
  OT
  RO
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum AuthProvider {
  PASSWORD
  GOOGLE
}

model User {
  id                          String              @id @default(cuid())
  email                       String              @unique // stored lowercased
  name                        String
  phone                       String?
  jobTitle                    String?
  role                        Role
  status                      UserStatus          @default(ACTIVE)
  passwordHash                String?
  authProvider                AuthProvider        @default(PASSWORD)
  managerId                   String?
  manager                     User?               @relation("Reports", fields: [managerId], references: [id])
  reportees                   User[]              @relation("Reports")
  canManageUsers              Boolean             @default(false) // delegation flag (OM only)
  canManageTaskTypes          Boolean             @default(false) // delegation flag (OM only, used in F02)
  technicianType              TechnicianType? // required for role OT (service layer), null otherwise
  baseLocationId              String? // required for role OT (service layer), null otherwise
  baseLocation                Location?           @relation("UserBaseLocation", fields: [baseLocationId], references: [id])
  // --- Home location (F09, D-129): OT and OE only, set by the user themselves; all four set together or none ---
  homeLat                     Float?
  homeLng                     Float?
  homeAddress                 String? // 3..300
  homeUpdatedAt               DateTime?
  createdAt                   DateTime            @default(now())
  updatedAt                   DateTime            @updatedAt
  invitesSent                 Invite[]            @relation("InvitedBy")
  refreshTokens               RefreshToken[]
  clientsCreated              Client[]            @relation("ClientCreatedBy")
  tasksAsOe                   Task[]              @relation("TaskOe")
  tasksCreated                Task[]              @relation("TaskCreatedBy")
  tasksDeleted                Task[]              @relation("TaskDeletedBy")
  fitments                    Fitment[]           @relation("FitmentTechnician")
  taskEvents                  TaskEvent[]         @relation("TaskEventActor")
  fitmentsVerified            Fitment[]           @relation("FitmentVerifiedBy")
  fitmentsApproved            Fitment[]           @relation("FitmentApprovedBy")
  fitmentsReopened            Fitment[]           @relation("FitmentLastReopenedBy")
  reopenAttributions          ReopenAttribution[]
  fitmentsVerificationUpdated Fitment[]           @relation("FitmentVerificationUpdatedBy")
  photosUploaded              FitmentPhoto[]      @relation("PhotoUploadedBy")
  photosChanged               FitmentPhoto[]      @relation("PhotoChangedBy")
  travelTasks                 TravelTask[]        @relation("TravelTechnician")
  travelRaised                TravelTask[]        @relation("TravelRaisedBy")
  travelVerified              TravelTask[]        @relation("TravelVerifiedBy")
  travelRejected              TravelTask[]        @relation("TravelRejectedBy")
  travelReopened              TravelTask[]        @relation("TravelReopenedBy")
  travelEvents                TravelTaskEvent[]   @relation("TravelEventActor")
  dayRoutes                   DayRoute[]          @relation("DayRouteTechnician")
  dayDistances                DayDistance[]       @relation("DayDistanceUser")
  notifications               Notification[]      @relation("NotificationRecipient")
  notificationsCaused         Notification[]      @relation("NotificationActor")
  travelUploads               TravelAttachment[]  @relation("TravelAttachmentUploadedBy")
  travelRemovals              TravelAttachment[]  @relation("TravelAttachmentRemovedBy")

  @@index([managerId])
  @@index([role, baseLocationId])
}

model Invite {
  id             String          @id @default(cuid())
  email          String
  role           Role
  managerId      String?
  jobTitle       String?
  // Optional prefill (technician invites) and OT profile copied to the user on accept.
  name           String?
  phone          String?
  technicianType TechnicianType?
  baseLocationId String?
  baseLocation   Location?       @relation("InviteBaseLocation", fields: [baseLocationId], references: [id])
  tokenHash      String          @unique // sha256 of the random token; raw token never stored
  expiresAt      DateTime // now + 72h
  usedAt         DateTime?
  revokedAt      DateTime?
  invitedById    String
  invitedBy      User            @relation("InvitedBy", fields: [invitedById], references: [id])
  createdAt      DateTime        @default(now())

  @@index([email])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// --- Master data (F02) ---

enum LookupKind {
  ASSET_TYPE
  DEVICE_TYPE
  INSTALLATION_TYPE
  STATE
  REGION
  ISSUE_REPORTED
  ISSUE_OBSERVED
  ACTION_TAKEN
  FINAL_ISSUE
  ACCESSORY
  CLOSE_REASON
  SHIFT_TYPE
  TASK_TYPE
}

enum TechnicianType {
  PAYROLL
  THIRD_PARTY
  CONTRACTUAL
}

/**
 * Simple masters share one table keyed by kind (D-047). Never deleted, only deactivated.
 */
model LookupItem {
  id                 String             @id @default(cuid())
  kind               LookupKind
  name               String
  nameKey            String // lower(trim(name)), used for uniqueness
  code               String? // stable code for built-ins (VEHICLE, BATTERY, OT, TT, FT, DAY, NIGHT, EARLY_MORNING, LAF5)
  isSystem           Boolean            @default(false) // built-in: cannot rename or deactivate
  active             Boolean            @default(true)
  billable           Boolean? // FINAL_ISSUE only
  sortOrder          Int                @default(0)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  activities         Activity[]
  locationsInState   Location[]         @relation("LocationState")
  locationsInRegion  Location[]         @relation("LocationRegion")
  tasksByType        Task[]             @relation("TaskType")
  tasksByAssetType   Task[]             @relation("TaskAssetType")
  tasksByDevice      Task[]             @relation("TaskDeviceType")
  tasksByInstall     Task[]             @relation("TaskInstallationType")
  tasksByShift       Task[]             @relation("TaskShiftType")
  tasksByIssue       Task[]             @relation("TaskIssueReported")
  fitmentsClosed     Fitment[]          @relation("FitmentCloseReason")
  fitmentsObserved   Fitment[]          @relation("FitmentIssueObserved")
  fitmentsActions    Fitment[]          @relation("FitmentActionTaken")
  fitmentsFinal      Fitment[]          @relation("FitmentFinalIssue")
  fitmentAccessories FitmentAccessory[]

  @@unique([kind, nameKey])
  @@unique([kind, code])
}

model Activity {
  id          String     @id @default(cuid())
  name        String
  nameKey     String
  assetTypeId String // LookupItem of kind ASSET_TYPE
  assetType   LookupItem @relation(fields: [assetTypeId], references: [id])
  active      Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  tasks       Task[]

  @@unique([assetTypeId, nameKey])
}

model VehicleMakeModel {
  id        String   @id @default(cuid())
  make      String
  model     String
  key       String // lower(make)|lower(model)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tasks     Task[]

  @@unique([key])
}

model Location {
  id          String       @id @default(cuid())
  city        String
  cityKey     String
  stateId     String // LookupItem of kind STATE
  state       LookupItem   @relation("LocationState", fields: [stateId], references: [id])
  regionId    String // LookupItem of kind REGION
  region      LookupItem   @relation("LocationRegion", fields: [regionId], references: [id])
  active      Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  technicians User[]       @relation("UserBaseLocation")
  invites     Invite[]     @relation("InviteBaseLocation")
  clientSites ClientSite[]
  tasks       Task[]
  travelTasks TravelTask[]

  @@unique([stateId, cityKey])
  @@index([regionId])
}

// --- Clients (F03) ---

/**
 * A customer. Never deleted, only deactivated. Always has at least one active site (service layer).
 */
model Client {
  id           String       @id @default(cuid())
  name         String
  nameKey      String       @unique // lower(trim(name))
  code         String?      @unique // uppercased, trimmed; [A-Z0-9-]{2,12}
  contactName  String
  contactPhone String
  contactEmail String?
  billingEmail String?
  notes        String?
  active       Boolean      @default(true)
  createdById  String
  createdBy    User         @relation("ClientCreatedBy", fields: [createdById], references: [id])
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  sites        ClientSite[]
  tasks        Task[]
  travelTasks  TravelTask[]
}

/**
 * A client location with a map pin (D-052).
 */
model ClientSite {
  id           String   @id @default(cuid())
  clientId     String
  client       Client   @relation(fields: [clientId], references: [id])
  name         String
  nameKey      String
  address      String
  lat          Float // -90..90
  lng          Float // -180..180
  locationId   String // Location (F02); must be active when set or changed
  location     Location @relation(fields: [locationId], references: [id])
  contactName  String?
  contactPhone String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  tasks        Task[]

  @@unique([clientId, nameKey])
  @@index([locationId])
}

// --- Tasks (F04) ---

/**
 * Human id counters: 'OM', 'OE', 'TK' (D-065) and 'TT' (F08). Incremented inside the creating transaction.
 */
model Counter {
  name  String @id
  value Int    @default(0)
}

/**
 * Stored aggregate of the fitment statuses, set only by `recomputeTaskStatus`.
 */
enum TaskStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  COMPLETED
}

/**
 * The full workflow (D-011); F04 uses OPEN and ASSIGNED only.
 */
enum FitmentStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  SUBMITTED
  OE_VERIFIED
  OM_APPROVED
  CLOSED_NOT_DONE
  MOVED_TO_FT
  REOPENED
}

enum VehicleEntry {
  COUNT
  CSV
}

/**
 * A client requirement, split into one fitment per vehicle (D-009). Soft-deleted.
 */
model Task {
  id                 String            @id @default(cuid())
  omNo               Int               @unique // OM-00001
  oeNo               Int               @unique // OE-00001
  taskTypeId         String // LookupItem TASK_TYPE (code OT in F04)
  taskType           LookupItem        @relation("TaskType", fields: [taskTypeId], references: [id])
  clientId           String
  client             Client            @relation(fields: [clientId], references: [id])
  siteId             String
  site               ClientSite        @relation(fields: [siteId], references: [id])
  locationId         String // copied from site.locationId (D-061)
  location           Location          @relation(fields: [locationId], references: [id])
  pocName            String
  pocPhone           String
  pocEmail           String?
  oeId               String // User with role OE
  oe                 User              @relation("TaskOe", fields: [oeId], references: [id])
  technicianType     TechnicianType?
  assetTypeId        String // LookupItem ASSET_TYPE
  assetType          LookupItem        @relation("TaskAssetType", fields: [assetTypeId], references: [id])
  activityId         String
  activity           Activity          @relation(fields: [activityId], references: [id])
  deviceTypeId       String // LookupItem DEVICE_TYPE
  deviceType         LookupItem        @relation("TaskDeviceType", fields: [deviceTypeId], references: [id])
  makeModelId        String? // required iff the asset type code is VEHICLE
  makeModel          VehicleMakeModel? @relation(fields: [makeModelId], references: [id])
  installationTypeId String // LookupItem INSTALLATION_TYPE
  installationType   LookupItem        @relation("TaskInstallationType", fields: [installationTypeId], references: [id])
  requestedAt        DateTime // requested fitment date and time (UTC)
  fitmentAt          DateTime // fitment date and time (UTC)
  shiftTypeId        String // LookupItem SHIFT_TYPE
  shiftType          LookupItem        @relation("TaskShiftType", fields: [shiftTypeId], references: [id])
  issueReportedId    String // LookupItem ISSUE_REPORTED
  issueReported      LookupItem        @relation("TaskIssueReported", fields: [issueReportedId], references: [id])
  gpsAddress         String?
  comments           String?
  vehicleEntry       VehicleEntry
  status             TaskStatus        @default(OPEN)
  completedAt        DateTime? // when the task last became COMPLETED; cleared when it leaves (CR-04, set by recomputeTaskStatus)
  createdById        String
  createdBy          User              @relation("TaskCreatedBy", fields: [createdById], references: [id])
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  deletedAt          DateTime?
  deletedById        String?
  deletedBy          User?             @relation("TaskDeletedBy", fields: [deletedById], references: [id])
  fitments           Fitment[]
  events             TaskEvent[]

  @@index([status, deletedAt])
  @@index([oeId])
  @@index([clientId])
  @@index([fitmentAt])
  @@index([completedAt])
}

/**
 * One vehicle of a task: the technician's unit of work (TK-00001). F05 adds the workflow fields.
 */
model Fitment {
  id                      String              @id @default(cuid())
  tkNo                    Int                 @unique // TK-00001
  taskId                  String
  task                    Task                @relation(fields: [taskId], references: [id])
  seq                     Int // 1..N within the task
  status                  FitmentStatus       @default(OPEN)
  technicianId            String?
  technician              User?               @relation("FitmentTechnician", fields: [technicianId], references: [id])
  vehicleRegNo            String?
  chassisNo               String?
  assetNumber             String?
  oldDeviceId             String?
  // --- Workflow (F05) ---
  startedAt               DateTime?
  startLat                Float?
  startLng                Float?
  submittedAt             DateTime?
  verifiedAt              DateTime? // cleared by a reopen (the history keeps it)
  verifiedById            String?
  verifiedBy              User?               @relation("FitmentVerifiedBy", fields: [verifiedById], references: [id])
  approvedAt              DateTime? // cleared by a reopen
  approvedById            String?
  approvedBy              User?               @relation("FitmentApprovedBy", fields: [approvedById], references: [id])
  closedAt                DateTime?
  closeReasonId           String? // LookupItem CLOSE_REASON
  closeReason             LookupItem?         @relation("FitmentCloseReason", fields: [closeReasonId], references: [id])
  closeComments           String?
  faultyAt                DateTime?
  faultReason             String?
  replacementOfId         String?             @unique // set on the replacement of a fitment moved to FT (D-012)
  replacementOf           Fitment?            @relation("Replacement", fields: [replacementOfId], references: [id])
  replacement             Fitment?            @relation("Replacement")
  reopenCount             Int                 @default(0)
  lastReopenReason        String?
  lastReopenedAt          DateTime?
  lastReopenedById        String?
  lastReopenedBy          User?               @relation("FitmentLastReopenedBy", fields: [lastReopenedById], references: [id])
  // --- OE verification (F06) ---
  issueObservedId         String? // LookupItem ISSUE_OBSERVED
  issueObserved           LookupItem?         @relation("FitmentIssueObserved", fields: [issueObservedId], references: [id])
  actionTakenId           String? // LookupItem ACTION_TAKEN
  actionTaken             LookupItem?         @relation("FitmentActionTaken", fields: [actionTakenId], references: [id])
  finalIssueId            String? // LookupItem FINAL_ISSUE
  finalIssue              LookupItem?         @relation("FitmentFinalIssue", fields: [finalIssueId], references: [id])
  oeRemarks               String?
  otRemarks               String? // set by the technician on submit (F10, or the dev simulator)
  billable                Boolean? // snapshot of the final issue's flag at verification (D-101); cleared by a reopen
  verificationUpdatedAt   DateTime?
  verificationUpdatedById String?
  verificationUpdatedBy   User?               @relation("FitmentVerificationUpdatedBy", fields: [verificationUpdatedById], references: [id])
  // --- Technician form (F10B); vehicleRegNo, chassisNo and otRemarks (comments) are reused ---
  deviceId                String?
  secondaryDeviceId       String?
  clusterReadingKm        Int?
  deviceReplacement       DeviceReplacement?
  checks                  Json? // { assetCondition, accessories, batteryCondition, clusterMeter, canVoltage }: 'OK' | 'NOT_OK' | 'NA'
  formUpdatedAt           DateTime?
  accessories             FitmentAccessory[]
  photos                  FitmentPhoto[]
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt
  events                  TaskEvent[]
  reopenAttributions      ReopenAttribution[]
  travelTasks             TravelTask[]

  @@unique([taskId, seq])
  @@index([technicianId, status])
  @@index([status])
  @@index([reopenCount])
}

enum DeviceReplacement {
  DEVICE
  SIM
  NONE
}

// --- OE verification and photos (F06) ---

enum PhotoKind {
  BEFORE
  AFTER
  ASSET
  CLUSTER
  PLACEMENT
  DEBUG
}

enum PhotoStatus {
  ACTIVE
  REPLACED
  REMOVED
}

enum PhotoSource {
  OT
  OE
  OM
  SIMULATOR
}

/**
 * A photo of a fitment, stored in object storage under `objectKey` (D-102). Never deleted: a replaced or
 * removed photo keeps its object and gets a status, reason, actor and time (D-100).
 */
model FitmentPhoto {
  id           String        @id @default(cuid())
  fitmentId    String
  fitment      Fitment       @relation(fields: [fitmentId], references: [id])
  kind         PhotoKind
  objectKey    String        @unique // fitments/{fitmentId}/{photoId}.{ext}
  contentType  String
  sizeBytes    Int
  width        Int?
  height       Int?
  originalName String?
  takenAt      DateTime?
  lat          Float?
  lng          Float?
  uploadedById String
  uploadedBy   User          @relation("PhotoUploadedBy", fields: [uploadedById], references: [id])
  source       PhotoSource
  status       PhotoStatus   @default(ACTIVE)
  replacedById String?       @unique // the photo that replaced this one
  replacedBy   FitmentPhoto? @relation("PhotoReplacement", fields: [replacedById], references: [id])
  replaces     FitmentPhoto? @relation("PhotoReplacement")
  changeReason String?
  changedById  String?
  changedBy    User?         @relation("PhotoChangedBy", fields: [changedById], references: [id])
  changedAt    DateTime?
  createdAt    DateTime      @default(now())

  @@index([fitmentId, status])
}

/**
 * Accessories fitted (many-to-many with LookupItem of kind ACCESSORY).
 */
model FitmentAccessory {
  fitmentId   String
  fitment     Fitment    @relation(fields: [fitmentId], references: [id])
  accessoryId String
  accessory   LookupItem @relation(fields: [accessoryId], references: [id])

  @@id([fitmentId, accessoryId])
}

/**
 * One row per person a reopen counts against (D-074), for the reopen analytics (F15).
 */
model ReopenAttribution {
  id        String    @id @default(cuid())
  eventId   String // TaskEvent of type FITMENT_REOPENED
  event     TaskEvent @relation(fields: [eventId], references: [id])
  fitmentId String
  fitment   Fitment   @relation(fields: [fitmentId], references: [id])
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  role      Role // OT or OE at the time
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([fitmentId])
}

/**
 * Audit trail of a task (D-065); F05 adds workflow event types.
 */
model TaskEvent {
  id           String              @id @default(cuid())
  taskId       String
  task         Task                @relation(fields: [taskId], references: [id])
  fitmentId    String?
  fitment      Fitment?            @relation(fields: [fitmentId], references: [id])
  actorId      String
  actor        User                @relation("TaskEventActor", fields: [actorId], references: [id])
  type         String // TASK_EVENT_TYPES in @champ/shared (F04 types, F05 FITMENT_* workflow events, F06 verification/photo events)
  fromStatus   String?
  toStatus     String?
  data         Json? // a diff { field: [before, after] } or a payload (+ simulated / postStart / postApproval flags)
  createdAt    DateTime            @default(now())
  attributions ReopenAttribution[]

  @@index([taskId, createdAt])
}

// --- Travel tasks (F08) ---

enum TravelStatus {
  RAISED
  VERIFIED
  REJECTED
}

enum TravelSource {
  WEB
  MOBILE
}

/**
 * A technician's trip outside a planned fitment (TT-00001), verified by their OE or an OM for reimbursement
 * (D-119–D-122). Never deleted.
 */
model TravelTask {
  id               String             @id @default(cuid())
  ttNo             Int                @unique // TT-00001 (Counter 'TT')
  technicianId     String // User with role OT
  technician       User               @relation("TravelTechnician", fields: [technicianId], references: [id])
  locationId       String
  location         Location           @relation(fields: [locationId], references: [id])
  clientId         String? // optional (D-119)
  client           Client?            @relation(fields: [clientId], references: [id])
  purpose          String // 3..1000
  travelDate       DateTime           @db.Date // IST calendar day, not in the future
  relatedFitmentId String?
  relatedFitment   Fitment?           @relation(fields: [relatedFitmentId], references: [id])
  distanceKm       Decimal?           @db.Decimal(7, 1) // 0 < x <= 5000
  status           TravelStatus       @default(RAISED)
  source           TravelSource
  raisedById       String
  raisedBy         User               @relation("TravelRaisedBy", fields: [raisedById], references: [id])
  verifiedAt       DateTime?
  verifiedById     String?
  verifiedBy       User?              @relation("TravelVerifiedBy", fields: [verifiedById], references: [id])
  rejectedAt       DateTime?
  rejectedById     String?
  rejectedBy       User?              @relation("TravelRejectedBy", fields: [rejectedById], references: [id])
  rejectionReason  String?
  reopenedAt       DateTime?
  reopenedById     String?
  reopenedBy       User?              @relation("TravelReopenedBy", fields: [reopenedById], references: [id])
  reopenReason     String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  events           TravelTaskEvent[]
  attachments      TravelAttachment[]

  @@index([technicianId, status])
  @@index([travelDate])
  @@index([status])
}

/**
 * Audit trail of a travel task: TT_RAISED, TT_UPDATED, TT_VERIFIED, TT_REJECTED, TT_RESUBMITTED, TT_REOPENED,
 * TT_ATTACHMENT_ADDED, TT_ATTACHMENT_REMOVED (TRAVEL_EVENT_TYPES in @champ/shared).
 */
model TravelTaskEvent {
  id           String     @id @default(cuid())
  travelTaskId String
  travelTask   TravelTask @relation(fields: [travelTaskId], references: [id])
  actorId      String
  actor        User       @relation("TravelEventActor", fields: [actorId], references: [id])
  type         String
  fromStatus   String?
  toStatus     String?
  data         Json? // a diff { field: [before, after] } with readable names, a reason, attachment ids
  createdAt    DateTime   @default(now())

  @@index([travelTaskId, createdAt])
}

/**
 * A receipt (image or PDF) of a travel task in object storage. Never deleted: removal sets REMOVED (as D-100).
 */
model TravelAttachment {
  id           String     @id @default(cuid())
  travelTaskId String
  travelTask   TravelTask @relation(fields: [travelTaskId], references: [id])
  objectKey    String     @unique // travel/{travelTaskId}/{id}.{ext}
  contentType  String // image/jpeg|png|webp or application/pdf
  sizeBytes    Int
  width        Int?
  height       Int?
  originalName String?
  uploadedById String
  uploadedBy   User       @relation("TravelAttachmentUploadedBy", fields: [uploadedById], references: [id])
  status       String     @default("ACTIVE") // ACTIVE | REMOVED
  removedById  String?
  removedBy    User?      @relation("TravelAttachmentRemovedBy", fields: [removedById], references: [id])
  removedAt    DateTime?
  removeReason String?
  createdAt    DateTime   @default(now())

  @@index([travelTaskId, status])
}

// --- Day route (F10, D-015, D-155) ---

enum RouteOrigin {
  GPS
  HOME
}

enum RouteEngine {
  OSRM
  STRAIGHT_LINE
}

/**
 * The stored visiting order of a technician's (OT or OE) open fitments on one IST day. Reused while the set
 * of open fitments is unchanged; recomputed on *Recalculate route* or when that set changes.
 */
model DayRoute {
  id           String       @id @default(cuid())
  technicianId String
  technician   User         @relation("DayRouteTechnician", fields: [technicianId], references: [id])
  date         DateTime     @db.Date // IST day
  originLat    Float? // null: no GPS and no home location (order from the earliest stop)
  originLng    Float?
  originSource RouteOrigin?
  fitmentIds   String[] // open stops in visiting order at compute time
  legs         Json // [{ fitmentId, distanceM, durationS | null }]
  geometry     Json? // GeoJSON LineString (OSRM) or null (fallback)
  engine       RouteEngine
  computedAt   DateTime     @default(now())

  @@unique([technicianId, date])
}

/// The distance a field user travelled on an IST day (F12, D-216): cached per signature of the ordered start points.
model DayDistance {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation("DayDistanceUser", fields: [userId], references: [id])
  date       DateTime @db.Date // IST day
  signature  String // hash of the ordered (merged) start points
  distanceM  Int
  approx     Boolean // straight-line (routing unavailable)
  legs       Json // [{ fitmentId, distanceM }] per started fitment after the first
  computedAt DateTime @default(now())

  @@unique([userId, date])
}

/// An in-app notification (F13, D-228–D-232). Fitment ones of one action on one task are grouped (count, fitmentIds).
model Notification {
  id           String    @id @default(cuid())
  userId       String // recipient
  user         User      @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  type         String // NotificationType
  taskId       String?
  fitmentIds   String[] // grouped
  travelTaskId String?
  actorId      String?
  actor        User?     @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  title        String
  body         String?
  count        Int       @default(1)
  groupKey     String? // `${type}:${taskId}:${actorId}` for groupable types
  readAt       DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@index([createdAt])
}

/// Global search identifiers (F14, D-243): the fixed set (SEARCH_IDENTIFIERS in @champ/shared), switched on/off and
/// ranked by the SA. Seeded by the migration. The trigram expression indexes on Fitment's identifier columns live in
/// the migration only (Prisma can't express them).
model SearchIdentifierSetting {
  identifier String  @id // SearchIdentifier
  enabled    Boolean @default(true)
  sortOrder  Int
}
